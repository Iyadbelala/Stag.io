<mxfile host="app.diagrams.net" agent="Stag.io UML">
  <diagram id="deployment-diagram" name="Deployment Architecture Diagram">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Deployment Architecture — Stag.io Platform" style="text;html=1;fontSize=20;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- ============ CLIENT TIER ============ -->
        <mxCell id="tier-client" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#6c8ebf;strokeWidth=2;arcSize=8;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="440" height="450" as="geometry" />
        </mxCell>
        <mxCell id="tier-client-label" value="&lt;b&gt;Client Tier&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="200" height="25" as="geometry" />
        </mxCell>

        <!-- Browser -->
        <mxCell id="browser" value="&lt;b&gt;Web Browser&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Chrome / Firefox / Edge / Safari&lt;/font&gt;" style="shape=mxgraph.cisco.computers_and_peripherals.web_browser;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;shadow=1;fontSize=12;fontColor=#333333;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="80" height="65" as="geometry" />
        </mxCell>

        <!-- Next.js Frontend -->
        <mxCell id="nextjs" value="&lt;p style=&quot;margin:0;text-align:center;padding:4px;&quot;&gt;&lt;b&gt;Next.js Frontend&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;font-size:10px;padding:4px;&quot;&gt;• React 19 + TypeScript&lt;br&gt;• TailwindCSS 4&lt;br&gt;• next-intl (i18n: EN/FR)&lt;br&gt;• Socket.IO Client&lt;br&gt;• Axios HTTP Client&lt;br&gt;• Responsive (mobile‑first)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;shadow=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="120" width="230" height="170" as="geometry" />
        </mxCell>

        <!-- Pages inside frontend -->
        <mxCell id="pages" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;b&gt;Pages &amp; Dashboards&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;font-size:9px;padding:2px;&quot;&gt;Auth · Home · Offers · Companies&lt;br&gt;Student Dashboard · Company Dashboard&lt;br&gt;University Dashboard · Admin Panel&lt;br&gt;Super Admin · Chatbot · Profile&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#6c8ebf;rounded=1;arcSize=6;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="320" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e-browser-next" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="browser" target="nextjs" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e-next-pages" style="endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1;dashed=1;" edge="1" source="nextjs" target="pages" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ SERVER TIER ============ -->
        <mxCell id="tier-server" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#d6b656;strokeWidth=2;arcSize=8;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="540" y="70" width="480" height="950" as="geometry" />
        </mxCell>
        <mxCell id="tier-server-label" value="&lt;b&gt;Server Tier&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="200" height="25" as="geometry" />
        </mxCell>

        <!-- Express.js Backend -->
        <mxCell id="express" value="&lt;p style=&quot;margin:0;text-align:center;padding:4px;&quot;&gt;&lt;b&gt;Express.js Backend API&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;font-size:10px;padding:4px;&quot;&gt;• Node.js + TypeScript&lt;br&gt;• RESTful API (/api/*)&lt;br&gt;• JWT Auth (access + refresh)&lt;br&gt;• Helmet security headers&lt;br&gt;• CORS + cookie parser&lt;br&gt;• Morgan request logging&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;shadow=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="120" width="230" height="170" as="geometry" />
        </mxCell>

        <!-- Middleware -->
        <mxCell id="middleware" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;b&gt;Middleware&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;font-size:9px;padding:2px;&quot;&gt;Auth Guard · RBAC · Rate Limiter&lt;br&gt;Login Limiter · Error Handler&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#FFF9C4;strokeColor=#d6b656;rounded=1;arcSize=6;fontSize=10;dashed=1;" vertex="1" parent="1">
