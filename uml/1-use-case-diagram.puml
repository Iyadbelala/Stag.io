@startuml UseCase
title Use Case Diagram — Stag.io
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Student" as S
actor "Company" as C
actor "University" as U
actor "Admin" as A
actor "Super Admin" as SA
actor "Visitor" as V

rectangle "Stag.io" {

  ' ── Visitor ──
  usecase "View Homepage" as UC_HOME
  usecase "Register (Student)" as UC_REGISTER
  usecase "Register (Company)" as UC_REG_COMP
  usecase "Register (University)" as UC_REG_UNI
  usecase "Log In" as UC_LOGIN
  usecase "Verify Email (OTP)" as UC_VERIFY
  usecase "Reset Password" as UC_RESET
  usecase "Browse Public Companies" as UC_PUB_COMP
  usecase "Search Student Directory\n(public)" as UC_SEARCH

  ' ── Student ──
  usecase "Manage Profile\n(photo, bio, skills)" as UC_PROFILE
  usecase "Upload / Generate CV" as UC_CV
  usecase "Browse Internship Offers" as UC_BROWSE
  usecase "Apply to an Offer" as UC_APPLY
  usecase "View My Applications" as UC_MY_APPS
  usecase "Toggle Save Offer\n(bookmark)" as UC_SAVE
  usecase "Get SmartMatch\nRecommendations" as UC_MATCH
  usecase "Chat with AI Chatbot" as UC_CHAT
  usecase "Write a Review" as UC_REVIEW
  usecase "Access Student Portal\n(/student)" as UC_STU_DASH
  usecase "Receive Real-Time\nNotifications" as UC_NOTIF

  ' ── Company ──
  usecase "Manage Company Profile\n(logo, info)" as UC_COMP_PROFILE
  usecase "Create / Update /\nDelete Offer" as UC_POST
  usecase "Accept / Reject\nan Application" as UC_DECIDE
  usecase "Access Company Portal\n(/company)" as UC_COMP_DASH

  ' ── University ──
  usecase "Manage University Profile\n(info, logo)" as UC_UNI_PROFILE
  usecase "View University Students" as UC_UNI_STUDENTS
  usecase "View Student Applications" as UC_UNI_APPS
  usecase "Validate Internship\nAgreement" as UC_VALIDATE
  usecase "View Active Internships" as UC_UNI_ACTIVE
  usecase "View Pending Validations" as UC_UNI_PENDING
  usecase "Download Agreement PDF" as UC_UNI_PDF
  usecase "Access University Portal\n(/university)" as UC_UNI_DASH

  ' ── Admin ──
  usecase "View Accepted Applications" as UC_ADMIN_APPS
  usecase "View All Applications" as UC_ADMIN_ALL_APPS
  usecase "Validate Application" as UC_ADMIN_VALIDATE
  usecase "Download Agreement PDF" as UC_ADMIN_PDF

  ' ── Super Admin ──
  usecase "View Platform Statistics" as UC_STATS
  usecase "Approve / Reject\nPending Companies" as UC_APPROVE_COMP
  usecase "Approve / Reject\nPending Universities" as UC_APPROVE_UNI
}

' ── Visitor Relations ──
V --> UC_HOME
V --> UC_REGISTER
V --> UC_REG_COMP
V --> UC_REG_UNI
V --> UC_LOGIN
V --> UC_PUB_COMP
V --> UC_SEARCH
V --> UC_BROWSE

' ── Auth Relations ──
UC_REGISTER ..> UC_VERIFY : <<include>>
UC_REG_COMP ..> UC_VERIFY : <<include>>
UC_REG_UNI ..> UC_VERIFY : <<include>>
UC_LOGIN ..> UC_RESET : <<extend>>

' ── Student Relations ──
S --> UC_PROFILE
S --> UC_CV
S --> UC_BROWSE
S --> UC_APPLY
S --> UC_MY_APPS
S --> UC_SAVE
S --> UC_MATCH
S --> UC_CHAT
S --> UC_REVIEW
S --> UC_STU_DASH
S --> UC_NOTIF

' ── Company Relations ──
C --> UC_COMP_PROFILE
C --> UC_POST
C --> UC_DECIDE
C --> UC_COMP_DASH
C --> UC_NOTIF
C --> UC_REVIEW

' ── University Relations ──
U --> UC_UNI_PROFILE
U --> UC_UNI_STUDENTS
U --> UC_UNI_APPS
U --> UC_VALIDATE
U --> UC_UNI_ACTIVE
U --> UC_UNI_PENDING
U --> UC_UNI_PDF
U --> UC_UNI_DASH
U --> UC_NOTIF

' ── Admin Relations ──
A --> UC_ADMIN_APPS
A --> UC_ADMIN_ALL_APPS
A --> UC_ADMIN_VALIDATE
A --> UC_ADMIN_PDF

' ── Super Admin Relations ──
SA --> UC_STATS
SA --> UC_APPROVE_COMP
SA --> UC_APPROVE_UNI
SA --|> A : inherits

@enduml
