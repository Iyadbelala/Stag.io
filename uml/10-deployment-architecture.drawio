        <!-- Services Layer -->
        <mxCell id="services" value="&lt;p style=&quot;margin:0;text-align:center;padding:4px;&quot;&gt;&lt;b&gt;Business Services Layer&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;font-size:10px;padding:4px;&quot;&gt;• auth.service · matching.service&lt;br&gt;• applications.service · offers.service&lt;br&gt;• reviews.service · notifications.service&lt;br&gt;• profile.service · cv.service&lt;br&gt;• chatbot.service · university.service&lt;br&gt;• admin.service · superadmin.service&lt;br&gt;• search.service · saved.service&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;shadow=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="380" width="410" height="190" as="geometry" />
        </mxCell>

        <!-- SmartMatch Engine -->
        <mxCell id="smartmatch" value="&lt;p style=&quot;margin:0;text-align:center;padding:4px;&quot;&gt;&lt;b&gt;🎯 SmartMatch Engine&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;font-size:10px;padding:4px;&quot;&gt;Weighted scoring algorithm:&lt;br&gt;Skills (50%) · Department (25%)&lt;br&gt;Location (15%) · Title (10%)&lt;br&gt;&lt;b&gt;&amp;lt; 100ms response time&lt;/b&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;shadow=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="600" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Socket.IO -->
        <mxCell id="socketio" value="&lt;p style=&quot;margin:0;text-align:center;padding:4px;&quot;&gt;&lt;b&gt;⚡ Socket.IO&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;font-size:10px;padding:4px;&quot;&gt;Real-time WebSocket&lt;br&gt;JWT-authenticated rooms&lt;br&gt;Push notifications &amp;lt; 1s&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;shadow=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="820" y="600" width="180" height="120" as="geometry" />
