@startuml SequenceChatbot
title Sequence Diagram — AI Chatbot (Gemini)
skinparam sequenceMessageAlign center
autonumber

actor User as U
participant "Frontend\n(ChatBot Component)" as FE
participant "Backend\n(Express)" as BE
participant "ChatbotService" as SVC
database "PostgreSQL\n(Neon)" as DB
participant "Google Gemini\n3 Flash Preview" as AI

U -> FE : Open floating chatbot widget
U -> FE : Type a message (max 2000 chars)

FE -> BE : POST /api/chatbot\n{message, history[max 20]}\n(chatbotLimiter: 15 req/min)\n(auth: optional)
BE -> BE : Validate message length <= 2000\nValidate history length <= 20\nValidate history roles (user/model)

alt User is authenticated
  BE -> SVC : processChat(message, userId, history)
else Guest user
  BE -> SVC : processChat(message, null, history)
end

SVC -> SVC : needsData(message)\nDetect intent via keywords:\n→ 'recommend' | 'applications'\n| 'profile' | 'offers' | null

alt Intent = recommendations (authenticated)
  SVC -> DB : SELECT student (skills, department)
  SVC -> DB : SELECT active offers + companies
  SVC -> SVC : Run SmartMatch scoring
  SVC -> SVC : Inject top 5 offers\ninto system prompt context
else Intent = applications (authenticated)
  SVC -> DB : SELECT applications\nWHERE studentId = ?
  SVC -> SVC : Inject application breakdown\n(total, pending, accepted, rejected)
else Intent = profile (authenticated)
  SVC -> DB : SELECT student + user profile
  SVC -> SVC : Inject profile data\n+ completion percentage
else Intent = offers
  SVC -> DB : SELECT active offers count
  SVC -> SVC : Inject offers summary
end

SVC -> SVC : Build system prompt:\n- Stag.io platform knowledge\n  (signup, SmartMatch, applying...)\n- Rules (detailed, use markdown,\n  friendly, explain why)\n- Multilingual (EN, FR, AR)\n- Injected contextual data

SVC -> AI : generateContent(\nsystemPrompt\n+ conversation history\n+ user message)
AI --> SVC : Generated response text

SVC -> SVC : Format response\nExtract suggestions if any

SVC --> BE : {reply, suggestions[], data?}
BE --> FE : {reply, suggestions[], data?}
FE -> FE : Render markdown response\n(bold text with theme colors)
FE -> FE : Auto-scroll to latest message
FE --> U : Display chatbot response\n+ clickable suggestion chips

@enduml
