@startuml DeploymentDiagram
title Deployment Diagram — Stag.io
skinparam nodeStyle rectangle

node "Web Browser\n(Client)" as BROWSER {
  artifact "Next.js Application\n(React 19 + TypeScript)" as APP
  artifact "Socket.IO Client" as WS_CLIENT
  artifact "Cloudflare Turnstile\nWidget" as TW
}

node "Frontend Server\n(Vercel / Node.js)" as FE_SERVER {
  artifact "Next.js 16\n(SSR + Static)" as NEXTJS
  component "App Router" as ROUTER
}

node "Backend Server\n(Node.js / Express 5)" as BE_SERVER {
  artifact "REST API\nPort 5000" as API
  artifact "Socket.IO Server\n(WebSocket)" as WS_SERVER
  component "Middleware Stack" as MW {
    component "Helmet"
    component "CORS\n(credentials: true)"
    component "Morgan\n(Logging)"
    component "Rate Limiter\n(100 req/min)"
    component "CSRF\n(X-Requested-With)"
    component "JWT Auth\n(+ Token Blacklist)"
    component "RBAC"
  }
  component "Business Services\n(17 services)" as BIZ
  component "Drizzle ORM" as ORM
}

cloud "Neon" as NEON {
  database "PostgreSQL\n(Serverless)" as DB
}

cloud "Cloudinary" as CDN_CLOUD {
  storage "Images & Documents\nCDN\n(photos, logos, CVs, banners)" as CDN_STORE
}

cloud "Google Cloud" as GCP {
  component "Gemini 3 Flash Preview\nGenerative AI API" as GEMINI
}

cloud "Cloudflare" as CF {
  component "Turnstile\nBot Protection" as TURNSTILE
}

cloud "Google Workspace" as GW {
  component "Gmail SMTP\nEmail Service\n(verification, password reset)" as SMTP
}

' ── Connections ──
BROWSER --> FE_SERVER : HTTPS (Port 443)
TW --> TURNSTILE : JavaScript challenge
APP --> API : REST API\n(Axios + Bearer JWT\n+ httpOnly Cookie)
WS_CLIENT <--> WS_SERVER : WebSocket\n(Socket.IO + JWT auth)
NEXTJS --> ROUTER

ORM --> DB : PostgreSQL\n(Neon Serverless Driver)
BIZ --> CDN_STORE : Upload API\n(Multer → Cloudinary)
BIZ --> GEMINI : REST API\n(AI Chatbot)
MW --> TURNSTILE : Token Verification
BIZ --> SMTP : SMTP TLS\n(Port 587)

@enduml
