        </mxCell>

        <mxCell id="a6" value="6. Verify offer active &amp; no duplicate" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" edge="1" parent="1">
