        <mxCell id="tier-data-label" value="&lt;b&gt;Data Tier&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="200" height="25" as="geometry" />
