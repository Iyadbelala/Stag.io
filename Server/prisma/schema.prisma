generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  company
  admin
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(student)
  firstName    String
  lastName     String
  university   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?

  @@map("users")
}

model Student {
  id         String   @id @default(cuid())
  userId     String   @unique
  department String?
  cvUrl      String?
  skills     String[]
  bio        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("students")
}
