        <!-- ============ SUBMIT APPLICATION ============ -->
        <mxCell id="frag1" value="&lt;b&gt;Application Submission&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=200;height=25;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fillColor=#E8F5E9;strokeColor=#82b366;fontColor=#333333;rounded=1;fontSize=11;opacity=30;" vertex="1" parent="1">
