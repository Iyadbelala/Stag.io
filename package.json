{
  "name": "stag-io",
  "version": "0.1.0",
  "private": true,
  "description": "Internship management platform",
  "workspaces": [
    "App",
    "Server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:app\" \"npm run dev:server\"",
    "dev:app": "npm run dev --workspace=App",
    "dev:server": "npm run dev --workspace=Server",
    "build": "npm run build --workspace=shared && npm run build --workspace=App && npm run build --workspace=Server"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.18"
  }
}