        <mxCell id="c-cloud" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" source="services" target="cloudinary" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
