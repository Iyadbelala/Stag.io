<mxfile host="app.diagrams.net" modified="2026-04-16T12:00:00.000Z" agent="Stag.io UML" version="24.0.0">
  <diagram id="seq-auth" name="Sequence Diagram — Authentication">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Sequence Diagram — Authentication, Verification &amp; Session Management" style="text;html=1;fontSize=18;fontStyle=1;align=center;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- ============ PARTICIPANTS ============ -->
        <mxCell id="p-user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;(Student / Company / University)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=60;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;shadow=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="200" height="1500" as="geometry" />
        </mxCell>

        <mxCell id="p-captcha" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;Turnstile" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;shadow=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="60" width="150" height="1500" as="geometry" />
        </mxCell>

        <mxCell id="p-frontend" value="&lt;b&gt;Next.js&lt;/b&gt;&lt;br&gt;Frontend" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;shadow=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="160" height="1500" as="geometry" />
        </mxCell>

        <mxCell id="p-backend" value="&lt;b&gt;Express.js&lt;/b&gt;&lt;br&gt;Backend API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;shadow=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="60" width="160" height="1500" as="geometry" />
        </mxCell>

        <mxCell id="p-limiter" value="&lt;b&gt;Login&lt;/b&gt;&lt;br&gt;Limiter" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;shadow=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="60" width="130" height="1500" as="geometry" />
        </mxCell>

        <mxCell id="p-db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;shadow=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="60" width="160" height="1500" as="geometry" />
        </mxCell>

        <mxCell id="p-mail" value="&lt;b&gt;Mail Server&lt;/b&gt;&lt;br&gt;(SMTP)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;shadow=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1440" y="60" width="150" height="1500" as="geometry" />
        </mxCell>

        <!-- ============ REGISTRATION FRAGMENT ============ -->
        <mxCell id="frag-reg" value="&lt;b&gt;alt&lt;/b&gt; [User Registration]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=200;height=25;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fillColor=#E8F5E9;strokeColor=#82b366;fontColor=#333333;rounded=1;fontSize=11;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="1580" height="320" as="geometry" />
        </mxCell>

        <!-- Registration messages -->
        <mxCell id="m1" value="1. Fill registration form" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="160" y="200" as="sourcePoint" /><mxPoint x="385" y="200" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m2" value="2. Validate CAPTCHA token" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#999999;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="385" y="230" as="sourcePoint" /><mxPoint x="600" y="230" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m3" value="3. POST /api/auth/register" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="260" as="sourcePoint" /><mxPoint x="840" y="260" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m4" value="4. Validate university domain" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="290" as="sourcePoint" /><mxPoint x="1280" y="290" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m5" value="5. Hash password (bcrypt 12 rounds) &amp; create user + student" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="320" as="sourcePoint" /><mxPoint x="1280" y="320" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m6" value="6. Generate OTP &amp; hash with SHA-256" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="350" as="sourcePoint" /><mxPoint x="1280" y="350" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m7" value="7. Send OTP email (plaintext)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="380" as="sourcePoint" /><mxPoint x="1515" y="380" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m8" value="8. { requiresVerification: true }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="420" as="sourcePoint" /><mxPoint x="600" y="420" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m9" value="9. Show verification form" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="450" as="sourcePoint" /><mxPoint x="160" y="450" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ============ OTP VERIFICATION FRAGMENT ============ -->
        <mxCell id="frag-otp" value="&lt;b&gt;OTP Email Verification&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=180;height=25;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fillColor=#E3F2FD;strokeColor=#6c8ebf;fontColor=#333333;rounded=1;fontSize=11;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="1580" height="200" as="geometry" />
        </mxCell>

        <mxCell id="m10" value="10. Enter 6-digit OTP code" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="160" y="550" as="sourcePoint" /><mxPoint x="600" y="550" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m11" value="11. POST /api/auth/verify-email" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="580" as="sourcePoint" /><mxPoint x="840" y="580" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m12" value="12. Compare SHA-256(code) &amp; check expiry" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="610" as="sourcePoint" /><mxPoint x="1280" y="610" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m13" value="13. Set isEmailVerified = true" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="640" as="sourcePoint" /><mxPoint x="1280" y="640" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m14" value="14. Sign JWT access (15min) + refresh (7d) tokens" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="670" as="sourcePoint" /><mxPoint x="600" y="670" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ============ LOGIN FRAGMENT ============ -->
        <mxCell id="frag-login" value="&lt;b&gt;alt&lt;/b&gt; [Login Flow]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=150;height=25;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fillColor=#FFF3E0;strokeColor=#d6b656;fontColor=#333333;rounded=1;fontSize=11;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1580" height="350" as="geometry" />
        </mxCell>

        <mxCell id="m20" value="15. Enter email &amp; password" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="160" y="780" as="sourcePoint" /><mxPoint x="600" y="780" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m21" value="16. POST /api/auth/login (+ CAPTCHA token)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="810" as="sourcePoint" /><mxPoint x="840" y="810" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m22" value="17. isAccountLocked(email)?" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="840" as="sourcePoint" /><mxPoint x="1055" y="840" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m23" value="18. Find user by email" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="870" as="sourcePoint" /><mxPoint x="1280" y="870" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m24" value="19. bcrypt.compare(password, hash)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="900" as="sourcePoint" /><mxPoint x="1055" y="900" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Alt: invalid credentials -->
        <mxCell id="alt-inv" value="&lt;font size=&quot;1&quot;&gt;[Invalid] recordFailedAttempt()&lt;/font&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=230;height=18;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fillColor=#FFEBEE;strokeColor=#b85450;fontColor=#b85450;rounded=1;fontSize=10;opacity=30;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="925" width="420" height="35" as="geometry" />
        </mxCell>

        <mxCell id="m25" value="20. clearFailedAttempts() + check isEmailVerified" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="980" as="sourcePoint" /><mxPoint x="1280" y="980" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m26" value="21. Sign JWT tokens (access 15min + refresh 7d)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="1010" as="sourcePoint" /><mxPoint x="600" y="1010" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m27" value="22. Redirect to role-specific dashboard" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="1040" as="sourcePoint" /><mxPoint x="160" y="1040" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ============ TOKEN REFRESH FRAGMENT ============ -->
        <mxCell id="frag-refresh" value="&lt;b&gt;Token Refresh&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=130;height=25;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fillColor=#F3E5F5;strokeColor=#9673a6;fontColor=#333333;rounded=1;fontSize=11;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="1580" height="160" as="geometry" />
        </mxCell>

        <mxCell id="m30" value="23. Access token expired (401)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;fontColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="1160" as="sourcePoint" /><mxPoint x="600" y="1160" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m31" value="24. POST /api/auth/refresh (refreshToken)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="1190" as="sourcePoint" /><mxPoint x="840" y="1190" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m32" value="25. Verify refresh token &amp; check user active" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="1220" as="sourcePoint" /><mxPoint x="1280" y="1220" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m33" value="26. Return new access + refresh tokens (rotation)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="1250" as="sourcePoint" /><mxPoint x="600" y="1250" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ============ PASSWORD RESET FRAGMENT ============ -->
        <mxCell id="frag-reset" value="&lt;b&gt;Password Reset&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=140;height=25;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fillColor=#FFF8E1;strokeColor=#d6b656;fontColor=#333333;rounded=1;fontSize=11;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="1310" width="1580" height="180" as="geometry" />
        </mxCell>

        <mxCell id="m40" value="27. POST /api/auth/forgot-password (email)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="1350" as="sourcePoint" /><mxPoint x="840" y="1350" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m41" value="28. Hash reset token (SHA-256), store, set 1h expiry" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="1380" as="sourcePoint" /><mxPoint x="1280" y="1380" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m42" value="29. Send reset link email (plaintext token)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="1410" as="sourcePoint" /><mxPoint x="1515" y="1410" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m43" value="30. POST /api/auth/reset-password (token, new password)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="1440" as="sourcePoint" /><mxPoint x="840" y="1440" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m44" value="31. bcrypt new password &amp; update user" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="1470" as="sourcePoint" /><mxPoint x="1280" y="1470" as="targetPoint" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
