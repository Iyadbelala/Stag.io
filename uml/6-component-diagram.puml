@startuml ComponentDiagram
title Component Diagram — Stag.io Architecture
skinparam backgroundColor #FFFFFF
skinparam componentBackgroundColor #F5EFE6
skinparam componentBorderColor #4B2E2B
skinparam packageBackgroundColor #FDF8F2
skinparam packageBorderColor #C8A96A
skinparam arrowColor #4B2E2B

package "Frontend — Next.js 16 + React 19" as CLIENT {
  package "Pages (App Router)" as PAGES {
    [Homepage]
    [Internships]
    [Auth Pages]
    [Student Portal]
    [Company Portal]
    [University Portal]
    [Admin Portal]
  }
  package "State Management (Contexts)" as CTX {
    [AuthContext]
    [ThemeContext]
    [NotificationContext]
    [LanguageContext]
  }
  package "UI Components" as UI {
    [Navbar]
    [ChatBot]
    [FormField]
    [StatusBadge]
  }
  package "Libraries (Frontend)" as LIB_FE {
    [Axios HTTP Client]
    [i18n Translations]
  }
}

package "Backend — Express 5 + TypeScript" as SERVER {
  package "Routes" as ROUTES {
    [auth.routes]
    [offers.routes]
    [applications.routes]
    [matching.routes]
    [chatbot.routes]
    [admin.routes]
    [university.routes]
  }
  package "Middleware" as MW {
    [JWT Auth Middleware]
    [Role Middleware (RBAC)]
    [Rate Limiter]
    [CSRF Protection]
    [Turnstile Middleware]
    [Upload Middleware (Multer)]
  }
  package "Services (Business Logic)" as SVC {
    [AuthService]
    [MatchingService (SmartMatch)]
    [ChatbotService (Gemini)]
    [OffersService]
    [ApplicationsService]
    [ProfileService]
    [NotificationsService]
    [CVService (PDFKit)]
    [ReviewsService]
    [AdminService]
  }
  package "Database Layer" as MODEL {
    [Drizzle ORM]
    [DB Connection (Neon)]
  }
  package "Libraries (Backend)" as LIB_BE {
    [Nodemailer (Email)]
    [Cloudinary Client]
    [Token Blacklist]
    [Audit Logger]
  }
  [Socket.IO Server]
}

cloud "External Services" as EXT {
  database "PostgreSQL\n(Neon Serverless)" as NEON
  [Cloudinary CDN]
  [Google Gemini AI]
  [Cloudflare Turnstile]
  [Gmail SMTP]
}

' Frontend → Backend
[Axios HTTP Client] --> ROUTES : REST API (HTTPS / JWT)
[NotificationContext] --> [Socket.IO Server] : WebSocket

' Frontend Internal
PAGES --> CTX
PAGES --> UI
CTX --> [Axios HTTP Client]

' Backend Pipeline
ROUTES --> MW : Middleware pipeline
MW --> SVC : Business Logic
SVC --> MODEL : DB Queries
SVC --> LIB_BE : Utilities
[Socket.IO Server] --> SVC

' Backend → External
MODEL --> NEON : SQL (Drizzle ORM)
[Cloudinary Client] --> [Cloudinary CDN]
[ChatbotService (Gemini)] --> [Google Gemini AI]
[Turnstile Middleware] --> [Cloudflare Turnstile]
[Nodemailer (Email)] --> [Gmail SMTP]

@enduml
